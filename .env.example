# Password for the /admin area (single user)
ADMIN_PASSWORD=choose-a-strong-password

# Random secret used to sign the admin login cookie (any long random string)
SESSION_SECRET=paste-a-long-random-string-here

# Optional. Where services.json and uploaded photos are stored.
# On Railway leave this unset: the attached Volume's mount path is used
# automatically (RAILWAY_VOLUME_MOUNT_PATH). Locally it defaults to ./data.
# DATA_DIR=/data
