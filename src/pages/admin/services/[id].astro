---
import Layout from "../../../layouts/Layout.astro";
import { getService, MAX_PHOTOS_PER_SERVICE } from "../../../lib/file-storage.js";

export const prerender = false;

const id = Number(Astro.params.id);
const service = await getService(id);

if (!service) {
  return Astro.redirect("/admin?error=Service+not+found");
}

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? "";
const supabaseConfigured = Boolean(supabaseUrl);
const atPhotoLimit = service.photos.length >= MAX_PHOTOS_PER_SERVICE;
---

<Layout title={`Edit ${service.title} | GG Studio`}>
  <main class="mx-auto min-h-screen max-w-3xl px-5 py-12 sm:px-8">
    <a href="/admin" class="text-sm font-medium text-ink-soft hover:text-gold-dark">
      &larr; Back to services
    </a>

    <form method="POST" action={`/api/admin/services/${service.id}/update`} class="mt-6 flex gap-3">
      <input
        type="text"
        name="title"
        value={service.title}
        required
        class="flex-1 rounded-lg border border-ink/15 bg-cream-dim px-3 py-2.5 font-display text-xl font-semibold text-ink outline-none focus:border-gold-dark"
      />
      <button
        type="submit"
        class="rounded-full bg-ink px-6 py-2.5 text-sm font-medium text-cream transition-colors hover:bg-gold-dark"
      >
        Save Name
      </button>
    </form>

    <div class="mt-10">
      <div class="flex items-center justify-between">
        <h2 class="font-display text-lg font-semibold text-ink">
          Photos ({service.photos.length} / {MAX_PHOTOS_PER_SERVICE})
        </h2>
      </div>

      <ul class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-3">
        {
          service.photos.map((photo, index) => (
            <li class="overflow-hidden rounded-2xl bg-cream-dim">
              <img src={photo.url} alt={photo.alt} class="aspect-[4/5] w-full object-cover" loading="lazy" />
              <div class="space-y-2 p-3">
                <form method="POST" action={`/api/admin/services/${service.id}/photos/${photo.id}/update`} class="flex gap-1.5">
                  <input
                    type="text"
                    name="alt"
                    value={photo.alt}
                    placeholder="Alt text"
                    class="w-full min-w-0 rounded border border-ink/15 bg-cream px-2 py-1 text-xs text-ink outline-none focus:border-gold-dark"
                  />
                  <button type="submit" class="shrink-0 rounded border border-ink/15 px-2 py-1 text-xs text-ink hover:border-gold-dark">
                    Save
                  </button>
                </form>
                <div class="flex items-center justify-between gap-1">
                  <div class="flex gap-1">
                    <form method="POST" action={`/api/admin/services/${service.id}/photos/${photo.id}/move`}>
                      <input type="hidden" name="direction" value="up" />
                      <button type="submit" disabled={index === 0} aria-label="Move left/up" class="flex h-7 w-7 items-center justify-center rounded-full border border-ink/15 text-xs text-ink disabled:opacity-30">
                        ↑
                      </button>
                    </form>
                    <form method="POST" action={`/api/admin/services/${service.id}/photos/${photo.id}/move`}>
                      <input type="hidden" name="direction" value="down" />
                      <button type="submit" disabled={index === service.photos.length - 1} aria-label="Move right/down" class="flex h-7 w-7 items-center justify-center rounded-full border border-ink/15 text-xs text-ink disabled:opacity-30">
                        ↓
                      </button>
                    </form>
                  </div>
                  <form
                    method="POST"
                    action={`/api/admin/services/${service.id}/photos/${photo.id}/delete`}
                    onsubmit="return confirm('Remove this photo?')"
                  >
                    <button type="submit" class="rounded-full border border-red-200 px-3 py-1 text-xs font-medium text-red-700 hover:bg-red-50">
                      Delete
                    </button>
                  </form>
                </div>
              </div>
            </li>
          ))
        }
      </ul>

      {
        atPhotoLimit ? (
          <p class="mt-6 rounded-lg bg-cream-dim px-4 py-3 text-sm text-ink-soft">
            This service has reached the {MAX_PHOTOS_PER_SERVICE}-photo limit. Delete one above to
            upload another.
          </p>
        ) : supabaseConfigured ? (
          <div class="mt-6 rounded-2xl border-2 border-dashed border-ink/20 p-6 text-center">
            <input type="file" id="photo-file" accept="image/*" class="hidden" />
            <label
              for="photo-file"
              class="inline-block cursor-pointer rounded-full bg-ink px-6 py-2.5 text-sm font-medium text-cream transition-colors hover:bg-gold-dark"
            >
              Choose Photo to Upload
            </label>
            <p id="upload-status" class="mt-3 text-sm text-ink-soft" />
          </div>
        ) : (
          <p class="mt-6 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700">
            Supabase isn't configured yet (PUBLIC_SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY). See the
            README for setup steps.
          </p>
        )
      }
    </div>
  </main>
</Layout>

<script
  define:vars={{
    serviceId: service.id,
  }}
>
  const fileInput = document.getElementById("photo-file");
  const statusEl = document.getElementById("upload-status");

  fileInput?.addEventListener("change", async () => {
    const file = fileInput.files?.[0];
    if (!file) return;

    statusEl.textContent = "Uploading…";

    try {
      const formData = new FormData();
      formData.append("file", file);

      const uploadResponse = await fetch(`/api/admin/services/${serviceId}/photos/upload`, {
        method: "POST",
        body: formData,
      });

      if (!uploadResponse.ok) {
        const error = await uploadResponse.json().catch(() => ({}));
        throw new Error(error?.error || "Upload failed.");
      }

      const { url, supabasePublicId } = await uploadResponse.json();

      const saveResponse = await fetch(`/api/admin/services/${serviceId}/photos`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          url,
          alt: "",
          supabasePublicId,
        }),
      });

      if (!saveResponse.ok) {
        const error = await saveResponse.json().catch(() => ({}));
        throw new Error(error?.error || "Saving the photo failed.");
      }

      statusEl.textContent = "Uploaded! Refreshing…";
      window.location.reload();
    } catch (error) {
      statusEl.textContent = error instanceof Error ? error.message : "Something went wrong.";
    }
  });
</script>
