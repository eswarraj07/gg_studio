---
import { heroImage, studio } from "../data/content.js";

function unsplash(width) {
  return `${heroImage.base}?auto=format&fit=crop&w=${width}&q=80`;
}
---

<section id="top" class="relative flex min-h-[92vh] items-end overflow-hidden pt-24">
  <img
    src={unsplash(1600)}
    srcset={`${unsplash(800)} 800w, ${unsplash(1200)} 1200w, ${unsplash(1600)} 1600w`}
    sizes="100vw"
    alt={heroImage.alt}
    width="1600"
    height="2000"
    class="absolute inset-0 h-full w-full object-cover"
    fetchpriority="high"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-ink/20 to-ink/10"></div>

  <div class="relative mx-auto w-full max-w-6xl px-5 pb-16 sm:px-8 sm:pb-24">
    <p class="font-display text-sm uppercase tracking-[0.3em] text-cream/80">
      {studio.name} &mdash; Chennai
    </p>
    <h1 class="mt-4 max-w-xl font-display text-4xl font-semibold leading-tight text-cream sm:text-5xl md:text-6xl">
      Raw emotions, timeless frames.
    </h1>
    <p class="mt-5 max-w-md text-base text-cream/85 sm:text-lg">
      Years of experience behind the lens, now bringing bridal, wedding, maternity and
      family photography online.
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a
        href={studio.whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full bg-gold px-6 py-3 text-sm font-medium text-ink transition-colors hover:bg-gold-dark hover:text-cream"
      >
        Book a Session
      </a>
      <a
        href="#gallery"
        class="rounded-full border border-cream/60 px-6 py-3 text-sm font-medium text-cream transition-colors hover:bg-cream/10"
      >
        View Our Work
      </a>
    </div>
  </div>
</section>
