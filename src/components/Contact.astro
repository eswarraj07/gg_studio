---
import { studio } from "../data/content.js";
---

<section id="contact" class="px-5 py-20 sm:px-8 sm:py-28">
  <div class="mx-auto max-w-6xl">
    <div class="text-center">
      <p class="font-display text-sm uppercase tracking-[0.3em] text-gold-dark">Let's Talk</p>
      <h2 class="mt-4 font-display text-3xl font-semibold text-ink sm:text-4xl">
        Let's Shoot Your Story
      </h2>
    </div>

    <div class="mt-12 grid gap-8 md:grid-cols-2">
      <div class="space-y-6 rounded-2xl bg-cream-dim p-6 sm:p-8">
        <div>
          <p class="font-display text-sm font-semibold uppercase tracking-wide text-gold-dark">
            Studio Address
          </p>
          <a
            href={studio.mapLink}
            target="_blank"
            rel="noopener noreferrer"
            class="group mt-2 inline-block"
          >
            <address class="text-base not-italic leading-relaxed text-ink-soft group-hover:text-gold-dark">
              {studio.address.line1}<br />
              {studio.address.line2}<br />
              {studio.address.line3}
            </address>
            <span class="mt-1 inline-flex items-center gap-1 text-sm font-medium text-gold-dark underline-offset-4 group-hover:underline">
              Open in Google Maps
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M9 7h8v8" />
              </svg>
            </span>
          </a>
        </div>

        <div>
          <p class="font-display text-sm font-semibold uppercase tracking-wide text-gold-dark">
            Phone
          </p>
          <a
            href={`tel:+91${studio.phone}`}
            class="mt-2 inline-block text-base text-ink-soft hover:text-gold-dark"
          >
            {studio.phoneDisplay}
          </a>
        </div>

        <div class="flex flex-wrap gap-3 pt-2">
          <a
            href={studio.whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full bg-ink px-6 py-3 text-sm font-medium text-cream transition-colors hover:bg-gold-dark"
          >
            Message on WhatsApp
          </a>
          <a
            href={studio.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full border border-ink/20 px-6 py-3 text-sm font-medium text-ink transition-colors hover:border-gold-dark hover:text-gold-dark"
          >
            Instagram
          </a>
          <a
            href={studio.facebook}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full border border-ink/20 px-6 py-3 text-sm font-medium text-ink transition-colors hover:border-gold-dark hover:text-gold-dark"
          >
            Facebook
          </a>
        </div>
      </div>

      <div class="relative overflow-hidden rounded-2xl">
        <iframe
          src={studio.mapEmbedSrc}
          class="h-80 w-full border-0 md:h-full"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="CraftNexa studio location"
        ></iframe>
        <a
          href={studio.mapLink}
          target="_blank"
          rel="noopener noreferrer"
          class="absolute inset-x-3 bottom-3 rounded-xl bg-cream/95 px-4 py-3 text-sm text-ink shadow-md backdrop-blur transition-colors hover:bg-gold sm:inset-x-auto sm:max-w-xs"
        >
          <span class="block font-display font-semibold">{studio.name}</span>
          <span class="block text-ink-soft">
            {studio.address.line1}, {studio.address.line2}, {studio.address.line3}
          </span>
        </a>
      </div>
    </div>
  </div>
</section>
