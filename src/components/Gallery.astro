---
import { galleryImages } from "../data/content.js";
---

<section id="gallery" class="px-5 py-20 sm:px-8 sm:py-28">
  <div class="mx-auto max-w-6xl">
    <div class="text-center">
      <p class="font-display text-sm uppercase tracking-[0.3em] text-gold-dark">Stories We Told</p>
      <h2 class="mt-4 font-display text-3xl font-semibold text-ink sm:text-4xl">Portfolio</h2>
    </div>

    <div class="mt-12 columns-2 gap-4 sm:gap-6 md:columns-3">
      {
        galleryImages.map((image, index) => (
          <div class="mb-4 break-inside-avoid overflow-hidden rounded-2xl sm:mb-6">
            <button
              type="button"
              class="lightbox-trigger block w-full cursor-zoom-in border-0 bg-transparent p-0"
              data-index={index}
              aria-label={`View larger image: ${image.alt}`}
            >
              <img
                src={image.src}
                alt={image.alt}
                loading="lazy"
                width="720"
                height="900"
                class="w-full object-cover transition-transform duration-500 hover:scale-105"
              />
            </button>
          </div>
        ))
      }
    </div>
  </div>
</section>

<div
  id="lightbox"
  class="fixed inset-0 z-[60] hidden items-center justify-center bg-ink/95 p-4 sm:p-8"
>
  <button
    type="button"
    id="lightbox-close"
    aria-label="Close"
    class="absolute right-5 top-5 flex h-10 w-10 items-center justify-center rounded-full border border-cream/30 text-cream transition-colors hover:bg-cream/10 sm:right-8 sm:top-8"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
    </svg>
  </button>

  <button
    type="button"
    id="lightbox-prev"
    aria-label="Previous image"
    class="absolute left-2 top-1/2 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-cream/30 text-cream transition-colors hover:bg-cream/10 sm:left-6"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 18l-6-6 6-6" />
    </svg>
  </button>

  <img id="lightbox-img" src="" alt="" class="max-h-[88vh] max-w-full rounded-lg object-contain sm:max-w-[90vw]" />

  <button
    type="button"
    id="lightbox-next"
    aria-label="Next image"
    class="absolute right-2 top-1/2 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-cream/30 text-cream transition-colors hover:bg-cream/10 sm:right-6"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 18l6-6-6-6" />
    </svg>
  </button>
</div>

<script define:vars={{ images: galleryImages.map((image) => ({ src: image.src, alt: image.alt })) }}>
  const lightbox = document.getElementById("lightbox");
  const lightboxImg = document.getElementById("lightbox-img");
  const closeBtn = document.getElementById("lightbox-close");
  const prevBtn = document.getElementById("lightbox-prev");
  const nextBtn = document.getElementById("lightbox-next");
  const triggers = document.querySelectorAll(".lightbox-trigger");

  let currentIndex = 0;

  function show(index) {
    currentIndex = (index + images.length) % images.length;
    const image = images[currentIndex];
    lightboxImg.src = image.src;
    lightboxImg.alt = image.alt;
  }

  function open(index) {
    show(index);
    lightbox.classList.remove("hidden");
    lightbox.classList.add("flex");
    document.body.style.overflow = "hidden";
  }

  function close() {
    lightbox.classList.add("hidden");
    lightbox.classList.remove("flex");
    document.body.style.overflow = "";
  }

  triggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      open(Number(trigger.dataset.index));
    });
  });

  closeBtn.addEventListener("click", close);
  prevBtn.addEventListener("click", () => show(currentIndex - 1));
  nextBtn.addEventListener("click", () => show(currentIndex + 1));

  lightbox.addEventListener("click", (event) => {
    if (event.target === lightbox) close();
  });

  document.addEventListener("keydown", (event) => {
    if (lightbox.classList.contains("hidden")) return;
    if (event.key === "Escape") close();
    if (event.key === "ArrowLeft") show(currentIndex - 1);
    if (event.key === "ArrowRight") show(currentIndex + 1);
  });
</script>
