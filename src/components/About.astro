---
import { studio } from "../data/content.js";
---

<section id="about" class="mx-auto max-w-4xl px-5 py-20 text-center sm:px-8 sm:py-28">
  <p class="font-display text-sm uppercase tracking-[0.3em] text-gold-dark">Why {studio.name}</p>
  <h2 class="mt-4 font-display text-3xl font-semibold text-ink sm:text-4xl">
    Experienced hands, told through honest storytelling.
  </h2>
  <p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-ink-soft sm:text-lg">
    For years, {studio.name} has quietly captured Chennai&rsquo;s most beautiful weddings,
    families, and milestones. Built on trust, word-of-mouth, and a passion for authentic
    moments, we are finally bringing our craft online. You can expect the same timeless
    artistry and genuine emotion&mdash;now just a click away.
  </p>
</section>
